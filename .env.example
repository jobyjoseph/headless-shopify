# Complete url created using your store name. Example:
# https://<store-name>.myshopify.com/api/2026-01/graphql.json
NEXT_PUBLIC_SHOPIFY_STOREFRONT_GRAPHQL_ENDPOINT=

# Retrieved from Headless app or custom Shopify app
NEXT_PUBLIC_SHOPIFY_STOREFRONT_ACCESS_TOKEN=

# Auth secret for better-auth
BETTER_AUTH_SECRET=

# Multipass secret from Shopify admin
SHOPIFY_MULTIPASS_SECRET=

# Shared secret used by /api/draft route
SHOPIFY_PREVIEW_SECRET=

# Google OAuth credentials for authentication
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=